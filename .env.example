# Sweet Estate — configuration template. PLACEHOLDERS ONLY. Never commit real secrets.
#
# The Angular site is static: its public settings live in
#   src/environments/environment.prod.ts   (siteUrl, apiBaseUrl, ga4MeasurementId, adminPrototypeEnabled)
#   src/app/core/config/site.config.ts     (brand, WhatsApp number, social links)
# Values below mirror those settings and list what a future backend will need.

# --- Frontend build ----------------------------------------------------------
# Production origin, used for canonical URLs and sitemap.xml (overrides siteUrl at build time).
SITE_URL=https://www.your-domain.example

# --- Values to copy into environment.prod.ts ---------------------------------
# API_BASE_URL=https://api.your-domain.example/v1
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Future backend (not part of this repository) ----------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sweet_estate
SESSION_SECRET=replace-with-a-long-random-string
CORS_ALLOWED_ORIGIN=https://www.your-domain.example
# Optional: email notifications for new enquiries
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
ENQUIRY_NOTIFY_EMAIL=owner@your-domain.example
# Optional: CAPTCHA (e.g. Cloudflare Turnstile / reCAPTCHA) — server-side secret
CAPTCHA_SECRET_KEY=replace-me
